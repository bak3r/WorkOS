# com.workos.atlas.service.template — oneshot unit that runs `atlas tick`.
# Widened PATH so bun/glab resolve regardless of install method (homebrew, ~/.bun, linuxbrew).
# ported from public PR #1743, @schmetti-dev
[Unit]
Description=WorkOS Atlas asset-graph tick (events-then-hourly-full-sync)

[Service]
Type=oneshot
WorkingDirectory={{HOME}}/.claude
Environment=PATH={{PATH}}
Environment=HOME={{HOME}}
ExecStart={{BUN}} {{HOME}}/.claude/WORKOS/ATLAS/Atlas.ts tick
StandardOutput=append:{{HOME}}/.claude/WORKOS/MEMORY/OBSERVABILITY/atlas.log
StandardError=append:{{HOME}}/.claude/WORKOS/MEMORY/OBSERVABILITY/atlas.log
