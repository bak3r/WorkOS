# com.workos.worksweep.timer.template — pairs with com.workos.worksweep.service.template.
# Hourly cadence:
# OnBootSec fires once ~2min after boot, OnUnitActiveSec repeats hourly from the last
# run, and systemd's own start-rate limiting covers the throttle case.
#
# public PR #1692, @takanorinishida

[Unit]
Description=WorkOS Work Sweep timer — hourly

[Timer]
OnBootSec=2min
OnUnitActiveSec=60min
Persistent=true
Unit=com.workos.worksweep.service

[Install]
WantedBy=timers.target
